# Copy this file to .env and fill in your own key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the discovery agent loop.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Base URL of the mock bank back-office app (started via `npm run mock-app`).
MOCK_APP_BASE_URL=http://localhost:4000

# Port for the minimal operator (human-escalation) HTTP surface.
OPERATOR_PORT=4100
