<!DOCTYPE html>
<html>
<head>
  <title>Sub-Account Confirmation</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<table width="100%" bgcolor="#c0c0c0" cellpadding="10">
<tr><td>

<font face="Verdana" size="+1" color="#000080"><b>Member Services Console</b></font>
<hr>

<p><font color="green"><b>Sub-account opened successfully.</b></font></p>

<table border="1" cellpadding="6" bgcolor="#ffffff">
  <tr><td><b>Account Number</b></td><td><%= subAccount.accountNumber %></td></tr>
  <tr><td><b>Account Type</b></td><td><%= subAccount.accountType %></td></tr>
  <tr><td><b>Initial Deposit</b></td><td>$<%= subAccount.initialDeposit.toFixed(2) %></td></tr>
  <tr><td><b>Member</b></td><td><%= member.name %> (<%= member.id %>)</td></tr>
</table>

<p><a href="/members/<%= member.id %>">Return to Member</a></p>

</td></tr>
</table>
</body>
</html>
